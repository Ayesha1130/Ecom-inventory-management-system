# Required for sign-in, onboarding and the dashboard. The marketing site runs without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Later phases (server only, never exposed to the client):
# SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 6: payments, orders, email (server only; never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=            # test-mode key (sk_test_...). Live keys are refused.
STRIPE_WEBHOOK_SECRET=        # whsec_... from `stripe listen` or the dashboard endpoint
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=               # optional; without it, emails are skipped (and logged as skipped)
EMAIL_FROM=                   # e.g. "Nexora <orders@your-domain.com>"
CRON_SECRET=                  # optional: protects /api/cron/expire-orders
